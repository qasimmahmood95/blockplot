{
  "ci": {
    "collect": {
      "staticDistDir": "./.lhci-root",
      "url": [
        "http://localhost/blockplot/index.html",
        "http://localhost/blockplot/methodology/index.html",
        "http://localhost/blockplot/holdings/index.html",
        "http://localhost/blockplot/cycles/index.html",
        "http://localhost/blockplot/correlation/index.html",
        "http://localhost/blockplot/performance/index.html",
        "http://localhost/blockplot/real-returns/index.html",
        "http://localhost/blockplot/network/index.html",
        "http://localhost/blockplot/dca/index.html",
        "http://localhost/blockplot/gbp/dca/index.html"
      ],
      "numberOfRuns": 5,
      "settings": {
        "chromeFlags": "--no-sandbox --disable-dev-shm-usage"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.85,
            "aggregationMethod": "median"
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "cumulative-layout-shift": [
          "error",
          {
            "maxNumericValue": 0.005,
            "aggregationMethod": "median"
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./.lighthouseci/reports"
    }
  }
}
