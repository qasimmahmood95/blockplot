---
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/tokens.css';
import '../styles/global.css';
import {
  CURRENCIES,
  CURRENCY_META,
  currencyFormatters,
  currencyPath,
  type Currency,
} from '../lib/currency';
import { dataFor } from '../lib/data';
import { toJsonScript } from '../lib/embed';
import { PAGES, pageForPath } from '../lib/routes';

interface Props {
  title: string;
  description?: string;
  currency?: Currency;
}

const {
  title,
  description = 'Bitcoin financial analytics built from a versioned, pipeline-committed dataset.',
  currency = 'usd',
} = Astro.props;
const { stats, fetchedAt } = dataFor(currency).btcDaily;
const { money } = currencyFormatters(currency);

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// Nav links keep the reader in their currency; the switcher swaps currency
// while staying on the same page.
const sections = PAGES.map(({ page, label }) => ({
  href: currencyPath(base, currency, page),
  label,
}));
const currentPage = pageForPath(Astro.url.pathname);
const currencyLinks = CURRENCIES.map((c) => ({
  code: CURRENCY_META[c].label,
  href: currencyPath(base, c, currentPage),
  active: c === currency,
}));
const current = (href: string): boolean =>
  Astro.url.pathname.replace(/\/$/, '') === href.replace(/\/$/, '');

// Both currencies' latest closes: the header tile values a cost basis entered
// in either, and their ratio is the implied rate that makes that possible.
const latestJson = toJsonScript({
  usd: dataFor('usd').btcDaily.stats.latestPrice,
  gbp: dataFor('gbp').btcDaily.stats.latestPrice,
});

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(`${base}/og.png`, Astro.site);
---

<!doctype html>
<html lang="en" data-currency={currency}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="blockplot" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="blockplot — Bitcoin financial analytics, fully static and open"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script is:inline>
      // Before first paint: apply a pinned theme so there is no flash.
      // Storage can throw (blocked cookies); degrade to auto silently.
      try {
        const pinned = localStorage.getItem('theme');
        if (pinned === 'dark' || pinned === 'light') {
          document.documentElement.dataset.theme = pinned;
        }
      } catch {
        /* auto */
      }
    </script>
  </head>
  <body>
    <header class="site-header">
      <a class="wordmark" href={import.meta.env.BASE_URL}>blockplot</a>
      <nav class="site-nav" aria-label="Sections">
        {
          sections.map(({ href, label }) => (
            <a href={href} aria-current={current(href) ? 'page' : undefined}>
              {label}
            </a>
          ))
        }
      </nav>
      <div class="header-side">
        <p class="header-tick num">
          BTC <span id="tick-price">{money.format(stats.latestPrice)}</span>{' '}
          <span class="tick-date" id="tick-label">close {stats.latestDate}</span>
        </p>
        <p class="header-tick header-holdings num" id="header-holdings" hidden>
          <a href={currencyPath(base, currency, 'holdings')}>
            <span id="header-holdings-value"></span>{' '}
            <span class="tick-date" id="header-holdings-pnl"></span>
          </a>
        </p>
        <nav class="currency-switch num" aria-label="Currency">
          {
            currencyLinks.map(({ code, href, active }) => (
              <a href={href} aria-current={active ? 'true' : undefined}>
                {code}
              </a>
            ))
          }
        </nav>
        <button type="button" class="theme-toggle num" id="theme-toggle" aria-live="polite">
          theme: auto
        </button>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <p>
        Data: CoinGecko, blockchain.com, FRED/Yahoo, DeFiLlama &amp; mempool.space, refreshed every 6 h by CI · last fetch{' '}
        <span class="num">{fetchedAt.slice(0, 16).replace('T', ' ')} UTC</span>
      </p>
      <p><a href="https://github.com/qasimmahmood95/blockplot">source &amp; methodology</a></p>
    </footer>

    <script is:inline type="application/json" id="header-latest" set:html={latestJson} />
    <script>
      import { valueHoldings } from '../../pipeline/holdings';
      import type { Currency } from '../../pipeline/schema';
      import { chartData } from '../lib/charts';
      import { HOLDINGS_EVENT, readHoldings } from '../lib/holdings-store';

      const headerLatest = chartData<Record<Currency, number>>('header-latest');
      const pageCurrency = (document.documentElement.dataset.currency ?? 'usd') as Currency;
      // Declared here because both the holdings tile and the live ticker format
      // with it, and the tile renders first.
      const money = new Intl.NumberFormat('en-US', {
        style: 'currency',
        currency: pageCurrency.toUpperCase(),
        maximumFractionDigits: 0,
      });

      // Theme toggle: auto (OS preference) -> dark -> light, persisted.
      const root = document.documentElement;
      const button = document.getElementById('theme-toggle');
      const modes = ['auto', 'dark', 'light'] as const;
      type Mode = (typeof modes)[number];

      const currentMode = (): Mode => {
        const t = root.dataset.theme;
        return t === 'dark' || t === 'light' ? t : 'auto';
      };
      const apply = (mode: Mode): void => {
        if (mode === 'auto') delete root.dataset.theme;
        else root.dataset.theme = mode;
        if (button) button.textContent = `theme: ${mode}`;
        window.dispatchEvent(new Event('themechange'));
        // Persist last, guarded: a blocked-storage throw must not leave the
        // page restyled with stale charts or a lying label.
        try {
          if (mode === 'auto') localStorage.removeItem('theme');
          else localStorage.setItem('theme', mode);
        } catch {
          /* theme still applies for this page */
        }
      };
      if (button) {
        button.textContent = `theme: ${currentMode()}`;
        button.addEventListener('click', () => {
          const next = modes[(modes.indexOf(currentMode()) + 1) % modes.length] ?? 'auto';
          apply(next);
        });
      }

      // Holdings tile: reads what the reader entered on /holdings and values it
      // at the committed close. Hidden entirely when nothing is stored, so this
      // is invisible to anyone who never uses the feature.
      const holdingsEl = document.getElementById('header-holdings');
      const holdingsValueEl = document.getElementById('header-holdings-value');
      const holdingsPnlEl = document.getElementById('header-holdings-pnl');

      function renderHoldings(): void {
        if (!holdingsEl || !holdingsValueEl || !holdingsPnlEl) return;
        const stored = readHoldings();
        if (!stored || stored.btc <= 0) {
          holdingsEl.hidden = true;
          return;
        }
        const result = valueHoldings(stored, headerLatest[pageCurrency], pageCurrency, headerLatest);
        holdingsEl.hidden = false;
        holdingsValueEl.textContent = money.format(result.value);
        holdingsPnlEl.textContent =
          result.pnlPct === null ? 'holdings' : `${result.pnlPct >= 0 ? '+' : ''}${result.pnlPct.toFixed(1)}%`;
        holdingsPnlEl.className = `tick-date ${result.pnlPct === null ? '' : result.pnlPct < 0 ? 'down' : 'up'}`.trim();
      }
      renderHoldings();
      window.addEventListener(HOLDINGS_EVENT, renderHoldings);

      // Live spot ticker: one of the site's two sanctioned runtime fetches.
      // CoinGecko's simple-price endpoint is queried in the page's currency,
      // so the live upgrade works on both; the committed close stays as the
      // fallback when it fails.
      const tickCurrency = pageCurrency;
      const priceEl = document.getElementById('tick-price');
      const labelEl = document.getElementById('tick-label');
      async function refreshTicker(): Promise<void> {
        if (document.hidden || !priceEl || !labelEl) return;
        try {
          const res = await fetch(
            `https://api.coingecko.com/api/v3/simple/price?ids=bitcoin&vs_currencies=${tickCurrency}`,
            { headers: { accept: 'application/json' } },
          );
          if (!res.ok) return;
          const payload = (await res.json()) as { bitcoin?: Record<string, number> };
          const price = payload.bitcoin?.[tickCurrency];
          if (typeof price !== 'number' || !Number.isFinite(price) || price <= 0) return;
          priceEl.textContent = money.format(price);
          labelEl.textContent = 'live';
          labelEl.classList.add('tick-live');
        } catch {
          // keep the committed close
        }
      }
      refreshTicker();
      setInterval(refreshTicker, 60_000);
      document.addEventListener('visibilitychange', () => {
        if (!document.hidden) void refreshTicker();
      });
    </script>
  </body>
</html>
