---
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/tokens.css';
import '../styles/global.css';
import { btcDaily } from '../lib/data';
import { formatUsd } from '../lib/format';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Bitcoin financial analytics built from a versioned, pipeline-committed dataset.',
} = Astro.props;
const { stats, fetchedAt } = btcDaily;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const sections = [
  { href: `${base}/`, label: 'overview' },
  { href: `${base}/volatility/`, label: 'volatility & risk' },
  { href: `${base}/cycles/`, label: 'halving cycles' },
  { href: `${base}/correlation/`, label: 'correlation' },
  { href: `${base}/dca/`, label: 'dca' },
  { href: `${base}/flows/`, label: 'flows' },
];
const current = (href: string): boolean =>
  Astro.url.pathname.replace(/\/$/, '') === href.replace(/\/$/, '');

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(`${base}/og.png`, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="blockplot" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script is:inline>
      // Before first paint: apply a pinned theme so there is no flash.
      const pinned = localStorage.getItem('theme');
      if (pinned === 'dark' || pinned === 'light') {
        document.documentElement.dataset.theme = pinned;
      }
    </script>
  </head>
  <body>
    <header class="site-header">
      <a class="wordmark" href={import.meta.env.BASE_URL}>blockplot</a>
      <nav class="site-nav" aria-label="Sections">
        {
          sections.map(({ href, label }) => (
            <a href={href} aria-current={current(href) ? 'page' : undefined}>
              {label}
            </a>
          ))
        }
      </nav>
      <div class="header-side">
        <p class="header-tick num">
          BTC <span id="tick-price">{formatUsd(stats.latestPriceUsd)}</span>{' '}
          <span class="tick-date" id="tick-label">close {stats.latestDate}</span>
        </p>
        <button type="button" class="theme-toggle num" id="theme-toggle" aria-live="polite">
          theme: auto
        </button>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <p>
        Data: CoinGecko, blockchain.com, FRED/Yahoo &amp; DeFiLlama, refreshed every 6 h by CI · last fetch{' '}
        <span class="num">{fetchedAt.slice(0, 16).replace('T', ' ')} UTC</span>
      </p>
      <p><a href="https://github.com/qasimmahmood95/blockplot">source &amp; methodology</a></p>
    </footer>

    <script>
      // Theme toggle: auto (OS preference) -> dark -> light, persisted.
      const root = document.documentElement;
      const button = document.getElementById('theme-toggle');
      const modes = ['auto', 'dark', 'light'] as const;
      type Mode = (typeof modes)[number];

      const currentMode = (): Mode => {
        const t = root.dataset.theme;
        return t === 'dark' || t === 'light' ? t : 'auto';
      };
      const apply = (mode: Mode): void => {
        if (mode === 'auto') {
          delete root.dataset.theme;
          localStorage.removeItem('theme');
        } else {
          root.dataset.theme = mode;
          localStorage.setItem('theme', mode);
        }
        if (button) button.textContent = `theme: ${mode}`;
        window.dispatchEvent(new Event('themechange'));
      };
      if (button) {
        button.textContent = `theme: ${currentMode()}`;
        button.addEventListener('click', () => {
          const next = modes[(modes.indexOf(currentMode()) + 1) % modes.length] ?? 'auto';
          apply(next);
        });
      }

      // Live spot ticker: the site's one runtime fetch (CoinGecko public
      // endpoint). Committed close stays as the fallback when it fails.
      const priceEl = document.getElementById('tick-price');
      const labelEl = document.getElementById('tick-label');
      const usd = new Intl.NumberFormat('en-US', {
        style: 'currency',
        currency: 'USD',
        maximumFractionDigits: 0,
      });
      async function refreshTicker(): Promise<void> {
        if (document.hidden || !priceEl || !labelEl) return;
        try {
          const res = await fetch(
            'https://api.coingecko.com/api/v3/simple/price?ids=bitcoin&vs_currencies=usd',
            { headers: { accept: 'application/json' } },
          );
          if (!res.ok) return;
          const payload = (await res.json()) as { bitcoin?: { usd?: number } };
          const price = payload.bitcoin?.usd;
          if (typeof price !== 'number' || !Number.isFinite(price) || price <= 0) return;
          priceEl.textContent = usd.format(price);
          labelEl.textContent = 'live';
          labelEl.classList.add('tick-live');
        } catch {
          // keep the committed close
        }
      }
      refreshTicker();
      setInterval(refreshTicker, 60_000);
      document.addEventListener('visibilitychange', () => {
        if (!document.hidden) void refreshTicker();
      });
    </script>
  </body>
</html>
