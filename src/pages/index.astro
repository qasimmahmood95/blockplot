---
import MonthlyHeatmap from '../components/MonthlyHeatmap.astro';
import PriceChart from '../components/PriceChart.astro';
import Base from '../layouts/Base.astro';
import { btcDaily, monthlyReturns } from '../lib/data';
import { formatPct, formatUsd } from '../lib/format';

const { stats, rangeDays } = btcDaily;

const changes = [
  { label: '7d change', value: stats.change7dPct },
  { label: '30d change', value: stats.change30dPct },
];
---

<Base title="blockplot · Bitcoin analytics">
  <h1 class="visually-hidden">Bitcoin analytics</h1>

  <dl class="stat-grid">
    <div class="stat">
      <dt>Spot (daily close)</dt>
      <dd class="num">{formatUsd(stats.latestPriceUsd)}</dd>
      <dd class="sub num">{stats.latestDate}</dd>
    </div>
    {
      changes.map(({ label, value }) => (
        <div class="stat">
          <dt>{label}</dt>
          <dd class={`num ${value !== null && value < 0 ? 'down' : 'up'}`}>
            {value === null ? '—' : formatPct(value)}
          </dd>
        </div>
      ))
    }
    <div class="stat">
      <dt>{rangeDays}d high</dt>
      <dd class="num">{formatUsd(stats.rangeHighUsd)}</dd>
      <dd class="sub num">{stats.rangeHighDate}</dd>
    </div>
  </dl>

  <section class="chart-section">
    <h2>BTC / USD · daily close · past {rangeDays} days</h2>
    <PriceChart />
    <p class="method-note">
      Daily UTC closes from CoinGecko's public market-chart endpoint (history is capped at 365 days
      on the keyless tier; the newest point is the price at the last pipeline run). The site is
      fully static: a scheduled GitHub Actions job validates and commits the dataset
      to <code>/data</code>, and every figure above is derived from it by tested pure functions.
    </p>
  </section>

  <section class="chart-section">
    <h2>Monthly returns · {monthlyReturns.years[0]?.year}–{monthlyReturns.asOf.slice(0, 4)}</h2>
    <MonthlyHeatmap />
    <p class="heat-legend" aria-hidden="true">
      <span>−30%+</span>
      <span class="swatch heat-neg-4"></span>
      <span class="swatch heat-neg-3"></span>
      <span class="swatch heat-neg-2"></span>
      <span class="swatch heat-neg-1"></span>
      <span class="swatch heat-pos-1"></span>
      <span class="swatch heat-pos-2"></span>
      <span class="swatch heat-pos-3"></span>
      <span class="swatch heat-pos-4"></span>
      <span>+30%+</span>
    </p>
    <p class="method-note">
      Each cell is that month's last close over the previous month's, in percent; a month missing
      from the data makes the next month's figure span the gap, and the newest cell is
      month-to-date ({monthlyReturns.asOf}). The Year column compounds that year's available
      months, so a partial year is a partial figure. Shading uses fixed magnitude bands (5/15/30%)
      rather than data-relative scaling, so a colour means the same thing in every row; figures are
      printed in every cell, so colour is never the only signal. Computed in the pipeline from
      blockchain.com's full daily history by fixture-tested pure functions.
    </p>
  </section>
</Base>
