---
import DrawdownChart from '../../components/DrawdownChart.astro';
import VolChart from '../../components/VolChart.astro';
import Base from '../../layouts/Base.astro';
import { ethNote, fxNote, type Currency } from '../../lib/currency';
import { dataFor } from '../../lib/data';
import { currencyPaths } from '../../lib/routes';

export const getStaticPaths = currencyPaths;

const { currency } = Astro.props as { currency: Currency };
const { benchmarksDaily, riskMetrics } = dataFor(currency);
import { formatPct, formatRatio, formatUnsignedPct } from '../../lib/format';

const { rollingVol, drawdown, comparison, windowDays, asOf } = riskMetrics;

const latestVol = (window: number) =>
  rollingVol.find((w) => w.windowDays === window)?.series.at(-1) ?? null;
const vol30 = latestVol(30);
const vol90 = latestVol(90);
const btc = comparison.find((c) => c.asset === 'btc');

// Gold's and ether's labels carry whichever Yahoo series actually served the
// data (for gold, XAU/USD spot preferred with COMEX front-month as fallback).
// Ether's matters more than gold's, not less: in the GBP tree it is quoted
// natively as ETH-GBP rather than converted, so the ticker is the only thing
// on this page that says which of the two routes produced the row.
const sourceOf = (asset: string): string | undefined =>
  benchmarksDaily.benchmarks.find((b) => b.asset === asset)?.sourceSeries;
const goldSeries = sourceOf('gold');
const ethSeries = sourceOf('eth');
const assetLabels: Record<string, string> = {
  btc: 'Bitcoin',
  eth: ethSeries ? `Ether (${ethSeries})` : 'Ether',
  sp500: 'S&P 500',
  gold: goldSeries ? `Gold (${goldSeries})` : 'Gold',
};
---

<Base
  currency={currency}
  title="blockplot · volatility & risk"
  description="BTC realized volatility, drawdown, and risk-adjusted returns vs ether, the S&P 500 and gold, from a versioned pipeline-committed dataset."
>
  <h1 class="visually-hidden">Volatility &amp; risk</h1>

  <dl class="stat-grid">
    <div class="stat">
      <dt>30d realized vol</dt>
      <dd class="num">{vol30 ? formatUnsignedPct(vol30.volPct) : '—'}</dd>
      <dd class="sub num">annualized</dd>
    </div>
    <div class="stat">
      <dt>90d realized vol</dt>
      <dd class="num">{vol90 ? formatUnsignedPct(vol90.volPct) : '—'}</dd>
      <dd class="sub num">annualized</dd>
    </div>
    <div class="stat">
      <dt>1y realized vol</dt>
      <dd class="num">{btc ? formatUnsignedPct(btc.annualizedVolPct) : '—'}</dd>
      <dd class="sub num">full {windowDays}d window</dd>
    </div>
    <div class="stat">
      <dt>Max drawdown (1y)</dt>
      <dd class="num down">{formatPct(drawdown.maxDrawdownPct)}</dd>
      <dd class="sub num">{drawdown.peakDate} → {drawdown.troughDate}</dd>
    </div>
  </dl>

  <section class="chart-section">
    <h2>Realized volatility · rolling 30/90/365d · annualized</h2>
    <VolChart currency={currency} />
    <p class="method-note">
      Rolling sample standard deviation of daily log returns, annualized by √365 and shown as a
      percentage; each point uses the window of returns ending that day. The vol curves (and the
      30d/90d tiles, which read their latest points) derive from blockchain.com's full history
      series so even the 365d window has enough pre-window returns; the 1y figure, drawdown, and
      comparison table use CoinGecko's 365-day spot series, so figures can differ fractionally.
    </p>
  </section>

  <section class="chart-section">
    <h2>Drawdown from running peak · past {windowDays}d</h2>
    <DrawdownChart currency={currency} />
    <p class="method-note">
      Daily close relative to the highest close seen so far in the window. The deepest decline
      was {formatPct(drawdown.maxDrawdownPct)}, from the {drawdown.peakDate} peak to the trough
      on {drawdown.troughDate}.
    </p>
  </section>

  <section class="chart-section">
    <h2>Risk-adjusted comparison · {windowDays}d to {asOf}</h2>
    <div class="table-scroll">
      <table class="risk-table">
        <thead>
          <tr>
            <th scope="col">Asset</th>
            <th scope="col" class="num">Return</th>
            <th scope="col" class="num">Ann. vol</th>
            <th scope="col" class="num">Sharpe</th>
            <th scope="col" class="num">Sortino</th>
            <th scope="col" class="num">Max drawdown</th>
          </tr>
        </thead>
        <tbody>
          {
            comparison.map((row) => (
              <tr>
                <th scope="row">{assetLabels[row.asset] ?? row.asset}</th>
                <td class={`num ${row.totalReturnPct < 0 ? 'down' : 'up'}`}>
                  {formatPct(row.totalReturnPct)}
                </td>
                <td class="num">{formatUnsignedPct(row.annualizedVolPct)}</td>
                <td class="num">{formatRatio(row.sharpe)}</td>
                <td class="num">{formatRatio(row.sortino)}</td>
                <td class="num">{formatPct(row.maxDrawdownPct)}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p class="method-note">
      Daily closes: BTC from CoinGecko, S&amp;P 500 from FRED's keyless CSV export, gold and ether
      from Yahoo Finance's chart API (gold as XAU/USD spot when available, COMEX front-month
      futures otherwise; this dataset carries {goldSeries ?? 'no gold series'}
      {ethSeries ? ` and ${ethSeries}` : ''}) — FRED's LBMA gold series were discontinued in 2022.
      Each asset keeps its own trading calendar inside BTC's {windowDays}-day window; returns are
      daily log returns.
      Sharpe uses a 0% risk-free rate; Sortino uses target downside deviation below 0% over all
      observations. Annualization is by √365 for the assets that trade every day — BTC and ether —
      and √252 for the market-hours ones, so figures are indicative rather than strictly
      like-for-like. All metrics are computed in the pipeline by fixture-tested pure functions and
      committed to <code>/data</code>.{fxNote(currency)}{ethNote(currency, Boolean(ethSeries))}
    </p>
  </section>
</Base>
