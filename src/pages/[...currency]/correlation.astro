---
import CorrelationChart from '../../components/CorrelationChart.astro';
import Base from '../../layouts/Base.astro';
import { dxyNote, ethNote, fxNote, type Currency } from '../../lib/currency';
import { dataFor } from '../../lib/data';
import { currencyPaths } from '../../lib/routes';
import { CORRELATION_ASSETS } from '../../../pipeline/correlation';

export const getStaticPaths = currencyPaths;

const { currency } = Astro.props as { currency: Currency };
const { correlations } = dataFor(currency);
import { formatRatio } from '../../lib/format';

const { pairs, windowDays, minObs, regimeThreshold, regimeConfirmDays } = correlations;


// The honest freshness label: the last shared trading day any pair reaches
// (correlations lag the BTC calendar over weekends and holidays).
const lastCorrDate = pairs.reduce((max, p) => {
  const last = p.series.at(-1)?.date ?? '';
  return last > max ? last : max;
}, '');

const assetLabels: Record<string, string> = {
  btc: 'BTC',
  eth: 'ETH',
  sp500: 'S&P 500',
  gold: 'Gold',
  dxy: 'DXY',
};
// Derived from the data rather than written down. This list was hardcoded and
// was not updated when ETH was ingested, so the matrix stayed 4x4 while the
// file carried ten pairs — the page paid the payload for four pairs it never
// showed, and the note below claiming the non-BTC pairs "exist to fill the
// matrix" was false for three of them. Reading the assets off the pairs means
// a future asset cannot be ingested and silently left out of the one view it
// was ingested for, and an asset whose sources failed drops out on its own.
const assets = [...new Set(pairs.flatMap((p) => [p.a, p.b]))].sort(
  (a, b) => CORRELATION_ASSETS.indexOf(a as never) - CORRELATION_ASSETS.indexOf(b as never),
);

const hasEth = assets.includes('eth');
// Read off the data, not stated: the depth of this pair is set by ether's own
// history, not by the ten-year source caps the paragraph below gives as the
// reason for every other BTC pair.
const btcEthSeries = pairs.find((p) => p.pair === 'btc-eth')?.series ?? [];
const btcEthYears = (
  (Date.parse(`${btcEthSeries.at(-1)?.date ?? ''}T00:00:00Z`) -
    Date.parse(`${btcEthSeries[0]?.date ?? ''}T00:00:00Z`)) /
  (365.2425 * 86_400_000)
).toFixed(1);

const latest = new Map<string, number | null>(
  pairs.map((p) => [p.pair, p.series.at(-1)?.corr ?? null]),
);
const corrOf = (a: string, b: string): number | null =>
  a === b ? 1 : (latest.get(`${a}-${b}`) ?? latest.get(`${b}-${a}`) ?? null);

const cellClass = (a: string, b: string): string => {
  if (a === b) return 'num diag';
  const value = corrOf(a, b);
  if (value === null || value === 0) return 'num';
  return value > 0 ? 'num corr-pos' : 'num corr-neg';
};

const btcPairs = [
  { label: 'BTC – S&P 500', value: corrOf('btc', 'sp500') },
  { label: 'BTC – Gold', value: corrOf('btc', 'gold') },
  { label: 'BTC – DXY', value: corrOf('btc', 'dxy') },
];
---

<Base
  currency={currency}
  title="blockplot · correlation"
  description={`Rolling ${windowDays}-day correlation of BTC daily returns with ether, the S&P 500, gold, and the dollar index, over full history, with correlation-regime segmentation.`}
>
  <h1 class="visually-hidden">Correlation</h1>

  <dl class="stat-grid">
    {
      btcPairs.map(({ label, value }) => (
        <div class="stat">
          <dt>{label}</dt>
          <dd class="num">{formatRatio(value)}</dd>
          <dd class="sub num">{windowDays}d window</dd>
        </div>
      ))
    }
    <div class="stat">
      <dt>As of</dt>
      <dd class="num">{lastCorrDate || '—'}</dd>
      <dd class="sub num">last shared trading day</dd>
    </div>
  </dl>

  <section class="chart-section">
    <h2>Correlation matrix · trailing {windowDays}d</h2>
    <div class="table-scroll">
      <table class="risk-table corr-matrix">
        <thead>
          <tr>
            <th scope="col"><span class="visually-hidden">Asset</span></th>
            {assets.map((a) => <th scope="col" class="num">{assetLabels[a]}</th>)}
          </tr>
        </thead>
        <tbody>
          {
            assets.map((a) => (
              <tr>
                <th scope="row">{assetLabels[a]}</th>
                {assets.map((b) => <td class={cellClass(a, b)}>{formatRatio(corrOf(a, b))}</td>)}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>

  <section class="chart-section">
    <h2>Rolling {windowDays}d correlation &amp; regimes · by pair</h2>
    <CorrelationChart currency={currency} />
    <p class="method-note">
      Pearson correlation of daily log returns over a trailing {windowDays}-calendar-day window,
      computed on each pair's shared trading days (a holiday or weekend in either series becomes
      one multi-day return); windows holding fewer than {minObs} shared returns are omitted. Each
      pair with BTC in it carries its whole shared history, which for the benchmarks is about ten
      years — FRED publishes the S&amp;P 500 as a rolling decade, and ten years is the deepest
      range Yahoo serves at daily granularity rather than quietly coarsening to monthly bars. BTC
      and ether reach back {btcEthYears} years instead, bounded by ether's own history rather than
      by either source's cap, and every day of it rather than trading days only. Pairs
      <em>without</em> BTC keep a 365-day window — they exist to fill the matrix above, which reads
      one number from each, and at full depth they were more than half the dataset. Their regimes are still classified over the whole history, so a row may report
      a regime that began before the charted window and count observations the chart does not
      show.
    </p>
    <p class="method-note">
      <strong>Regimes.</strong> A reading of |corr| ≥ {regimeThreshold} counts as co-moving or
      inverse, anything inside that band as decoupled — but a threshold crossing is not a regime.
      The rolling curve oscillates, so a bare test would report dozens of one-day regimes around
      every crossing. A candidate must instead hold for {regimeConfirmDays} consecutive readings
      before it replaces the incumbent, and the boundary is then dated at the <em>first</em> of
      those readings, since that is when the change began rather than when it was confirmed. The
      cost of that rule is stated plainly: the last {regimeConfirmDays - 1} readings of a series
      cannot yet start a regime, so a turn in the past fortnight is shown as a continuation until
      the data earns the change. Segments are contiguous and cover every reading, and the mean is
      taken over the readings that established the regime — where a segment reaches back over an
      opening too short to confirm anything, the table says which date it was confirmed from.
    </p>
    <p class="method-note">
      BTC uses blockchain.com's daily series, the S&amp;P 500 FRED's, and gold, ether and the dollar
      index Yahoo Finance's (DXY falls back to front-month futures when the index itself is
      unavailable). Ether is dated differently from BTC and deliberately so — a Yahoo crypto bar
      already falls on the session it closes, where a 00:00-UTC BTC snapshot does not, which is
      measured on the methodology page. All values are computed in the pipeline by fixture-tested
      pure functions and committed to
      <code>/data</code>.{fxNote(currency)}{ethNote(currency, hasEth)}{dxyNote(currency)}
    </p>
  </section>
</Base>
