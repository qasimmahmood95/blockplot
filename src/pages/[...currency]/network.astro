---
import { currencyPaths } from '../../lib/routes';
import FeeTiers from '../../components/FeeTiers.astro';
import NetworkCharts from '../../components/NetworkCharts.astro';
import Base from '../../layouts/Base.astro';
import { network } from '../../lib/data';
import { formatPct } from '../../lib/format';
import { feeStandingLabel } from '../../../pipeline/network';

const { hashRate, txCount, feePerTx, asOf, keepDays } = network;
const latestTx = txCount.series.at(-1)?.value ?? null;
const latestFee = feePerTx?.series.at(-1)?.value ?? null;
// The percentile is the figure that makes the live tier readable, so it leads
// its tile and the raw satoshi count is the subtitle rather than the reverse.
// The sentence itself is built in the pipeline, where it is tested.
const feeStanding = feeStandingLabel(feePerTx?.percentile ?? null, keepDays);
const compact = new Intl.NumberFormat('en-US', { notation: 'compact', maximumFractionDigits: 1 });

export const getStaticPaths = currencyPaths;

// This view is currency-free — hash rate, transaction count and fee tiers are
// denominated in hashes, transactions and sat/vB — but the layout still needs
// the reader's currency so the nav and switcher keep them in it.
const { currency } = Astro.props as { currency: import('../../lib/currency').Currency };
---

<Base
  currency={currency}
  title="blockplot · network"
  description="Bitcoin network hash rate, daily transaction count, fee-per-transaction history, and current recommended fee tiers."
>
  <h1 class="visually-hidden">Network</h1>

  <dl class="stat-grid">
    <div class="stat">
      <dt>Hash rate</dt>
      <dd class="num">{hashRate.average7d === null ? '—' : `${compact.format(hashRate.average7d)} EH/s`}</dd>
      <dd class="sub num">7d mean · {asOf}</dd>
    </div>
    <div class="stat">
      <dt>Hash rate, 30d</dt>
      <dd
        class={`num ${hashRate.change30dPct === null ? '' : hashRate.change30dPct < 0 ? 'down' : 'up'}`}
      >
        {hashRate.change30dPct === null ? '—' : formatPct(hashRate.change30dPct)}
      </dd>
      <dd class="sub num">7d mean vs 30d ago</dd>
    </div>
    <div class="stat">
      <dt>Transactions</dt>
      <dd class="num">{latestTx === null ? '—' : compact.format(latestTx)}</dd>
      <dd class="sub num">confirmed, {asOf}</dd>
    </div>
    <div class="stat">
      <dt>Daily avg, 30d</dt>
      <dd class="num">{txCount.average30d === null ? '—' : compact.format(txCount.average30d)}</dd>
      <dd class="sub num">transactions</dd>
    </div>
  </dl>

  <section class="chart-section">
    <h2>Recommended fees · sat/vB</h2>
    <FeeTiers />
    <p class="method-note">
      Fee tiers from mempool.space's keyless recommended-fees endpoint. Unlike every other figure
      on the site these move on a ~10-minute timescale, so a 6-hourly committed value would be
      stale by the time you read it: the page ships the committed snapshot and an island refreshes
      it live (every 2 minutes while the tab is visible), falling back to the snapshot on any
      failure. This is the site's second sanctioned runtime fetch, alongside the header ticker.
    </p>
  </section>

  {
    feePerTx && (
      <dl class="stat-grid">
        <div class="stat">
          <dt>Fee per transaction</dt>
          <dd class="num">{latestFee === null ? '—' : `${compact.format(latestFee)} sats`}</dd>
          <dd class="sub num">{feeStanding ?? 'no standing yet'}</dd>
        </div>
        <div class="stat">
          <dt>Fee, 30d mean</dt>
          <dd class="num">
            {feePerTx.average30d === null ? '—' : `${compact.format(feePerTx.average30d)} sats`}
          </dd>
          <dd class="sub num">per confirmed tx</dd>
        </div>
        <div class="stat">
          <dt>Fee, 30d change</dt>
          <dd
            class={`num ${feePerTx.change30dPct === null ? '' : feePerTx.change30dPct < 0 ? 'down' : 'up'}`}
          >
            {feePerTx.change30dPct === null ? '—' : formatPct(feePerTx.change30dPct)}
          </dd>
          <dd class="sub num">7d mean vs 30d ago</dd>
        </div>
      </dl>
    )
  }

  <section class="chart-section">
    {/* The heading names only what is actually drawn. It said "& fees"
        unconditionally, so a run that lost the fee series left a heading
        promising a third chart that was not there. */}
    <h2>{`Hash rate, transactions${feePerTx ? ' & fees' : ''} · trailing ${keepDays}d`}</h2>
    <NetworkCharts />
    <p class="method-note">
      Network hash rate (exahashes per second, converted in the pipeline from blockchain.com's
      TH/s) and confirmed transactions per day, both from blockchain.com's keyless charts API —
      the same source and payload shape as the price history, so parsing is shared. Hash rate is
      estimated from block timing rather than measured, so its daily value swings several percent
      on chance alone: the headline figure and the 30d change both use trailing 7-day means, which
      is why the tiles can differ from the last point on the chart. blockchain.com publishes
      complete UTC days, so this page lags the price pages by a day. All figures are computed in
      the pipeline by fixture-tested pure functions.
    </p>
    {
      feePerTx && (
        <p class="method-note">
          Fee per transaction is derived rather than fetched: blockchain.com publishes total fees
          per day and transactions per day, and the quotient is what a transaction actually cost,
          where the raw series is what the whole network paid. It is in satoshis — this page carries
          chain properties only, so a currency would need an exchange rate the rest of the page does
          not use, and the tiers above are already quoted in sat/vB. The two series are joined on
          date rather than by position, since they arrive as separate requests: a day present in one
          and missing from the other would otherwise pair the wrong values and shift everything
          after it.
          {feePerTx.percentile !== null &&
            ` The standing beside it is the share of the last ${keepDays} days strictly below today, which is the number that makes a sat/vB tier mean something — it is what the tiers above lacked entirely until now.`}
          The axis is logarithmic because the range is the story: fees sit in the low hundreds of
          satoshis for months and spike into the tens of thousands, and on a linear axis every quiet
          period is a flat line on the floor.
        </p>
      )
    }
  </section>
</Base>
