---
import Base from '../layouts/Base.astro';

// One 404 for both currencies, not one per currency: GitHub Pages serves the
// site-root 404.html for every unmatched path, so a /gbp/404.html would be
// built and never requested. It therefore renders in the default currency —
// the overview link below is the way back, not the switcher.
---

<Base title="blockplot · not found" description="Page not found.">
  <section class="chart-section">
    <h1 class="notfound-code num">404</h1>
    <h2>No such chart</h2>
    <p class="method-note">
      This page doesn't exist. The data, however, does — start at
      the <a href={import.meta.env.BASE_URL}>overview</a> or pick a section from the header.
    </p>
  </section>
</Base>
