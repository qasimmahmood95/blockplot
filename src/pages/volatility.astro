---
import DrawdownChart from '../components/DrawdownChart.astro';
import VolChart from '../components/VolChart.astro';
import Base from '../layouts/Base.astro';
import { benchmarksDaily, riskMetrics } from '../lib/data';
import { formatPct, formatRatio, formatUnsignedPct } from '../lib/format';

const { rollingVol, drawdown, comparison, windowDays, asOf } = riskMetrics;

const latestVol = (window: number) =>
  rollingVol.find((w) => w.windowDays === window)?.series.at(-1) ?? null;
const vol30 = latestVol(30);
const vol90 = latestVol(90);
const btc = comparison.find((c) => c.asset === 'btc');

// Gold's label carries whichever Yahoo series actually served the data
// (XAU/USD spot preferred, COMEX front-month futures as fallback).
const goldSeries = benchmarksDaily.benchmarks.find((b) => b.asset === 'gold')?.sourceSeries;
const assetLabels: Record<string, string> = {
  btc: 'Bitcoin',
  sp500: 'S&P 500',
  gold: goldSeries ? `Gold (${goldSeries})` : 'Gold',
};
---

<Base
  title="blockplot · volatility & risk"
  description="BTC realized volatility, drawdown, and risk-adjusted returns vs S&P 500 and gold, from a versioned pipeline-committed dataset."
>
  <h1 class="visually-hidden">Volatility &amp; risk</h1>

  <dl class="stat-grid">
    <div class="stat">
      <dt>30d realized vol</dt>
      <dd class="num">{vol30 ? formatUnsignedPct(vol30.volPct) : '—'}</dd>
      <dd class="sub num">annualized</dd>
    </div>
    <div class="stat">
      <dt>90d realized vol</dt>
      <dd class="num">{vol90 ? formatUnsignedPct(vol90.volPct) : '—'}</dd>
      <dd class="sub num">annualized</dd>
    </div>
    <div class="stat">
      <dt>1y realized vol</dt>
      <dd class="num">{btc ? formatUnsignedPct(btc.annualizedVolPct) : '—'}</dd>
      <dd class="sub num">full {windowDays}d window</dd>
    </div>
    <div class="stat">
      <dt>Max drawdown (1y)</dt>
      <dd class="num down">{formatPct(drawdown.maxDrawdownPct)}</dd>
      <dd class="sub num">{drawdown.peakDate} → {drawdown.troughDate}</dd>
    </div>
  </dl>

  <section class="chart-section">
    <h2>Realized volatility · rolling 30/90d · annualized</h2>
    <VolChart />
    <p class="method-note">
      Rolling sample standard deviation of daily log returns, annualized by √365 and shown as a
      percentage. Each point uses the window of returns ending that day, so the 30d line starts 30
      days into the dataset. A 365d rolling line needs history beyond CoinGecko's keyless 365-day
      cap and arrives once M2 sources full price history.
    </p>
  </section>

  <section class="chart-section">
    <h2>Drawdown from running peak · past {windowDays}d</h2>
    <DrawdownChart />
    <p class="method-note">
      Daily close relative to the highest close seen so far in the window. The deepest decline
      was {formatPct(drawdown.maxDrawdownPct)}, from the {drawdown.peakDate} peak to the trough
      on {drawdown.troughDate}.
    </p>
  </section>

  <section class="chart-section">
    <h2>Risk-adjusted comparison · {windowDays}d to {asOf}</h2>
    <div class="table-scroll">
      <table class="risk-table">
        <thead>
          <tr>
            <th scope="col">Asset</th>
            <th scope="col" class="num">Return</th>
            <th scope="col" class="num">Ann. vol</th>
            <th scope="col" class="num">Sharpe</th>
            <th scope="col" class="num">Sortino</th>
            <th scope="col" class="num">Max drawdown</th>
          </tr>
        </thead>
        <tbody>
          {
            comparison.map((row) => (
              <tr>
                <th scope="row">{assetLabels[row.asset] ?? row.asset}</th>
                <td class={`num ${row.totalReturnPct < 0 ? 'down' : 'up'}`}>
                  {formatPct(row.totalReturnPct)}
                </td>
                <td class="num">{formatUnsignedPct(row.annualizedVolPct)}</td>
                <td class="num">{formatRatio(row.sharpe)}</td>
                <td class="num">{formatRatio(row.sortino)}</td>
                <td class="num">{formatPct(row.maxDrawdownPct)}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p class="method-note">
      Daily closes: BTC from CoinGecko, S&amp;P 500 from FRED's keyless CSV export, gold from
      Yahoo Finance's chart API (XAU/USD spot when available, COMEX front-month futures otherwise;
      this dataset carries {goldSeries ?? 'no gold series'}) — FRED's LBMA gold series were
      discontinued in 2022. Each asset keeps its own trading calendar inside BTC's {windowDays}-day
      window; returns are daily log returns.
      Sharpe uses a 0% risk-free rate; Sortino uses target downside deviation below 0% over all
      observations. Both annualize by √365 for BTC and √252 for market-hours assets, so figures are
      indicative rather than strictly like-for-like. All metrics are computed in the pipeline by
      fixture-tested pure functions and committed to <code>/data</code>.
    </p>
  </section>
</Base>
