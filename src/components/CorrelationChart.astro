---
import type { Currency } from '../lib/currency';
import { dataFor } from '../lib/data';
import { toJsonScript } from '../lib/embed';
import { encodeDaily } from '../lib/series-codec';
import { renderResponsiveChart } from '../lib/plot-ssr';
import {
  bandFill,
  correlationSpec,
  pairLabel,
  REGIME_LABELS,
  REGIME_ORDER,
  regimeFrom,
  type Pair,
} from '../lib/specs/correlation';

interface Props {
  currency: Currency;
}

const { currency } = Astro.props;
const { correlations } = dataFor(currency);
const pairs = correlations.pairs.filter((p) => p.series.length > 0) as Pair[];
// Each pair's readings go over the wire as a start date plus one number per
// day, or plus the gaps between the days it has. btc-eth is crypto against
// crypto, so it is the one pair here that is genuinely daily-contiguous and
// takes the first form; the rest are trading-day based — nine of the ten, ~540
// weekend gaps apiece — and take the second. They used to write every date out,
// which was most of this page's weight: it is 37.8 KB gzipped now against 65.6.
// The encoder decides per pair rather than being told, and anything neither
// form can reproduce exactly still stores its rows rather than silently
// shifting a reading.
const payload = {
  threshold: correlations.regimeThreshold,
  pairs: pairs.map((p) => ({ ...p, series: encodeDaily(p.series, 'corr') })),
};
const active = pairs[0];

// Only the pressed pair's chart is drawn: ten SVGs would be ten times the
// markup for nine charts nobody has asked to see. The tables are another
// matter — all ten are a few dozen rows, and rendering them here means the
// pair switch is a visibility change rather than a DOM build.
const svg = active
  ? renderResponsiveChart((w) => correlationSpec(active, correlations.regimeThreshold, w, false))
  : '';
---

<figure class="chart-frame">
  <div class="chart-controls">
    <div class="chart-toggle" id="pair-toggle" role="group" aria-label="Asset pair">
      {
        pairs.map((p, i) => (
          <button type="button" data-pair={p.pair} aria-pressed={i === 0 ? 'true' : 'false'}>
            {pairLabel(p)}
          </button>
        ))
      }
    </div>
    <div class="chart-legend" id="regime-legend" aria-hidden="true">
      {
        REGIME_ORDER.map((regime) => {
          const fill = bandFill(regime);
          const style = fill
            ? `background:color-mix(in srgb, ${fill} 35%, transparent)`
            : 'background:transparent;border:1px solid var(--line)';
          return (
            <span class="legend-item">
              <span class="legend-swatch regime-swatch" style={style} />
              {REGIME_LABELS[regime]}
            </span>
          );
        })
      }
    </div>
  </div>
  <script
    is:inline
    type="application/json"
    id="correlation-chart-data"
    set:html={toJsonScript(payload)}
  />
  <div
    id="correlation-chart"
    role="img"
    aria-label="Line chart of the rolling 90-day correlation of daily log returns for the selected asset pair, with shaded correlation-regime bands"
    set:html={svg}
  />
</figure>

<div class="table-scroll regime-table-wrap">
  {
    pairs.map((p, i) => (
      <table class="risk-table regime-table" data-pair={p.pair} hidden={i !== 0}>
        <caption class="visually-hidden">
          Correlation regimes for {pairLabel(p)}, newest first
        </caption>
        <thead>
          <tr>
            <th scope="col">Regime</th>
            <th scope="col">From</th>
            <th scope="col">To</th>
            <th scope="col" class="num">
              Days
            </th>
            <th scope="col" class="num">
              Obs
            </th>
            <th scope="col" class="num">
              Mean corr
            </th>
          </tr>
        </thead>
        <tbody>
          {/* Newest first: the regime a reader cares about is the current one. */}
          {[...p.regimes].reverse().map((segment) => (
            <tr>
              <th scope="row" class={`regime-${segment.regime}`}>
                {REGIME_LABELS[segment.regime]}
              </th>
              <td>{regimeFrom(segment)}</td>
              <td>{segment.endDate}</td>
              <td class="num">{segment.days}</td>
              <td class="num">{segment.observations}</td>
              <td class="num">{segment.meanCorr.toFixed(2)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    ))
  }
</div>

<script>
  import { chartData, upgradeChart } from '../lib/charts';
  import { decodeDaily, type DailySeries } from '../lib/series-codec';
  import type { Pair } from '../lib/specs/correlation';

  const container = document.getElementById('correlation-chart');
  const toggle = document.getElementById('pair-toggle');
  const tables = document.querySelectorAll<HTMLTableElement>('.regime-table');

  if (container) {
    const { threshold, pairs: encoded } = chartData<{
      threshold: number;
      pairs: (Omit<Pair, 'series'> & { series: DailySeries<'corr'> })[];
    }>('correlation-chart-data');
    // Decoded eagerly, and deliberately so: only one pair is drawn at a time,
    // but the pair switch is a press and decoding then would put the work
    // between the press and the redraw. Ten pairs of a few thousand numbers is
    // a fraction of the JSON.parse that just produced them.
    const pairs = encoded.map(
      (p) => ({ ...p, series: decodeDaily(p.series, 'corr') }) as unknown as Pair,
    );
    let active = pairs[0]?.pair ?? '';

    const upgrade = upgradeChart(container, async () => {
      const [{ drawChart }, { correlationSpec }] = await Promise.all([
        import('../lib/plot-client'),
        import('../lib/specs/correlation'),
      ]);

      const pair = pairs.find((p) => p.pair === active) ?? pairs[0];
      if (!pair) return;
      drawChart(container, (w) => correlationSpec(pair, threshold, w, true));
    });

    const show = (pair: string): void => {
      toggle
        ?.querySelectorAll('button')
        .forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.pair === pair)));
      // The tables are all already here; switching pair only changes which one
      // is shown.
      tables.forEach((t) => {
        t.hidden = t.dataset.pair !== pair;
      });
    };

    toggle?.querySelectorAll('button').forEach((button) => {
      button.addEventListener('click', () => {
        const previous = active;
        active = button.dataset.pair ?? active;
        show(active);
        // If Plot never arrives the chart is still the old pair's, so put the
        // pressed button and the table back rather than captioning the wrong
        // chart with the right label.
        upgrade().catch(() => {
          active = previous;
          show(active);
        });
      });
    });
  }
</script>
