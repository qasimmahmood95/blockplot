---
import type { Currency } from '../lib/currency';
import { CURRENCY_META } from '../lib/currency';
import { dataFor } from '../lib/data';
import { toJsonScript } from '../lib/embed';
import { encodeDaily } from '../lib/series-codec';

interface Props {
  currency: Currency;
}

import { compareDcaVsLumpSum } from '../../pipeline/dca';
import { renderResponsiveChart } from '../lib/plot-ssr';
import { dcaSpec, defaultStartDate, wealthExtent } from '../lib/specs/dca';
import {
  DCA_LEGEND_BASE,
  dcaFormatters,
  dcaTiles,
  legendSwatch,
} from '../lib/specs/dca-shared';

const { currency } = Astro.props;
const { btcHistory } = dataFor(currency);
const meta = CURRENCY_META[currency];
const payload = { code: meta.code, series: encodeDaily(btcHistory.series, 'price') };

const firstDate = btcHistory.series[0]?.date ?? '';
const lastDate = btcHistory.series.at(-1)?.date ?? '';
const startDate = defaultStartDate(firstDate, lastDate);

// The form's own defaults, simulated here so the page arrives complete. The
// held-stack line is absent by construction: it comes from localStorage, which
// the build has no access to and, per CLAUDE.md, must never be given.
const initial = compareDcaVsLumpSum(btcHistory.series, {
  startDate,
  amount: 100,
  feePct: 0.5,
  frequency: 'weekly',
});
const dcaPoints = initial.dca.series.map((p) => ({ date: new Date(p.date), wealth: p.wealth }));
const lumpPoints = initial.lumpSum.series.map((p) => ({ date: new Date(p.date), wealth: p.wealth }));
const { money: ssrMoney, signedPct: ssrSignedPct } = dcaFormatters(meta.code);
// Rendered into the markup so the grid is not empty until script runs. It used
// to fill in on load and push the chart down 204px — the largest layout shift
// left on the site, and the reason /dca was kept out of the CLS assertion.
const initialTiles = dcaTiles(
  {
    totalInvested: initial.dca.totalInvested,
    totalFees: initial.dca.totalFees,
    buys: initial.dca.purchases.length,
    btcAccumulated: initial.dca.btcAccumulated,
    dcaFinal: initial.dca.finalValue,
    dcaReturnPct: initial.dca.returnPct,
    lumpFinal: initial.lumpSum.finalValue,
    lumpReturnPct: initial.lumpSum.returnPct,
    delta: initial.delta,
  },
  ssrMoney,
  ssrSignedPct,
);

const svg = renderResponsiveChart((w) =>
  dcaSpec({
    dcaPoints,
    lumpPoints,
    heldPoints: [],
    wealthDomain: wealthExtent(dcaPoints, lumpPoints),
    width: w,
    axisMoney: ssrMoney,
    tipMoney: ssrMoney,
    interactive: false,
  }),
);
---

<script is:inline type="application/json" id="dca-data" set:html={toJsonScript(payload)} />

<form class="sim-form" id="dca-form">
  <label>
    <span>Start date</span>
    <input type="date" name="startDate" value={startDate} min={firstDate} max={lastDate} required />
  </label>
  <label>
    <span>Frequency</span>
    <select name="frequency">
      <option value="weekly" selected>weekly</option>
      <option value="monthly">monthly</option>
    </select>
  </label>
  <label>
    <span>Amount / buy ({meta.symbol})</span>
    <input type="number" name="amount" min="1" step="1" value="100" required />
  </label>
  <label>
    <span>Fee / buy (%)</span>
    <input type="number" name="feePct" min="0" max="5" step="0.1" value="0.5" required />
  </label>
</form>

<dl class="stat-grid" id="dca-stats" aria-live="polite">
  {
    initialTiles.map((t) => (
      <div class="stat">
        <dt>{t.label}</dt>
        <dd class={`num ${t.tone}`.trim()}>{t.value}</dd>
        <dd class="sub num">{t.sub}</dd>
      </div>
    ))
  }
</dl>

<figure class="chart-frame">
  <div id="dca-legend" class="chart-legend" aria-hidden="true">
    {
      DCA_LEGEND_BASE.map((entry) => (
        <span class="legend-item">
          <span class="legend-swatch" style={`background:${legendSwatch(entry)}`} />
          {entry.label}
        </span>
      ))
    }
  </div>
  <div
    id="dca-chart"
    role="img"
    aria-label="Line chart comparing DCA and lump-sum portfolio wealth over time"
    set:html={svg}
  />
</figure>

<script>
  import { compareDcaVsLumpSum, type DcaFrequency } from '../../pipeline/dca';
  import { holdingsSeries } from '../../pipeline/holdings';
  import { chartData, upgradeChart } from '../lib/charts';
  import { decodeDaily } from '../lib/series-codec';
  import {
    DCA_LEGEND_BASE,
    dcaFormatters,
    dcaTiles,
    legendSwatch,
    wealthExtent,
  } from '../lib/specs/dca-shared';
  import { clipNote, compactMoney } from '../lib/chart-format';
  import { HOLDINGS_EVENT, readHoldings } from '../lib/holdings-store';

  // Decoded once, eagerly: every stat tile is a function of this series, and
  // they are drawn on load, so there is nothing to defer it behind. Measured
  // in the built page: 3.9 ms unthrottled, 16.3 ms at the 4x CPU throttle
  // Lighthouse uses — against 0.16 ms to JSON.parse the payload it replaces.
  // Worth knowing rather than guessed at; an earlier version of this comment
  // said "about a millisecond" and was out by more than an order of magnitude.
  const { code, series: encodedSeries } = chartData<{
    code: string;
    series: Parameters<typeof decodeDaily>[0];
  }>('dca-data');
  const series = decodeDaily(encodedSeries, 'price') as { date: string; price: number }[];
  const lastDate = series.at(-1)?.date ?? '';

  const form = document.getElementById('dca-form') as HTMLFormElement | null;
  const stats = document.getElementById('dca-stats');
  const legend = document.getElementById('dca-legend');
  const container = document.getElementById('dca-chart');

  // The date field's value, min and max are rendered into the markup now, from
  // the same `defaultStartDate` this used to duplicate. A reader with JS off
  // gets a usable form, and the chart beside it is the one those defaults
  // produce.

  const { money: fmtMoney, signedPct } = dcaFormatters(code);
  const money = { format: fmtMoney };
  /**
   * Tooltip figures, shortened above eight digits.
   *
   * Applied to every line, not just the reader's own stack. The first attempt
   * at this reasoned that "the budget bounds the two simulated lines" — which
   * is false, and the mistake was load-bearing: the budget bounds what is
   * *invested*, not what it grows to. On the default form, with nothing
   * entered and the start date dragged to the beginning of the data, $83,200
   * of weekly buys becomes $4.8bn of lump-sum wealth, and that line was the
   * one being cut off.
   */
  const compact = new Intl.NumberFormat('en-US', {
    style: 'currency',
    currency: code,
    notation: 'compact',
    maximumFractionDigits: 2,
  });
  const tipMoney = (v: number): string =>
    compactMoney(v, (x) => money.format(x), (x) => compact.format(x));

  function readOptions() {
    if (!form) return null;
    const data = new FormData(form);
    const startDate = String(data.get('startDate') ?? '');
    const amount = Number(data.get('amount'));
    const feePct = Number(data.get('feePct'));
    const frequency = (data.get('frequency') === 'monthly' ? 'monthly' : 'weekly') as DcaFrequency;
    if (!startDate || startDate > lastDate || !(amount > 0) || !(feePct >= 0 && feePct < 100)) {
      return null;
    }
    return { startDate, amount, feePct, frequency };
  }

  function tile(label: string, value: string, sub: string, tone = ''): HTMLElement {
    const wrap = document.createElement('div');
    wrap.className = 'stat';
    const dt = document.createElement('dt');
    dt.textContent = label;
    const dd = document.createElement('dd');
    dd.className = `num ${tone}`.trim();
    dd.textContent = value;
    const ddSub = document.createElement('dd');
    ddSub.className = 'sub num';
    ddSub.textContent = sub;
    wrap.append(dt, dd, ddSub);
    return wrap;
  }

  /**
   * Write only when the result differs from what is already there.
   *
   * `#dca-stats` is `aria-live="polite"`, so replacing four tiles with four
   * identical tiles is still four removals and four additions — an
   * announcement that re-reads figures the reader could already see. That is
   * exactly what happens on arrival now the build renders the same defaults
   * the browser computes, and it would have made every page load announce
   * itself for nothing.
   *
   * Comparing rendered HTML rather than the inputs, because it is the rendered
   * text an assistive technology would read out.
   */
  function replaceIfChanged(target: Element, children: Element[]): void {
    const staged = document.createElement('div');
    staged.append(...children.map((c) => c.cloneNode(true)));
    if (staged.innerHTML === target.innerHTML) return;
    target.replaceChildren(...children);
  }

  /**
   * Everything both halves need, computed once from the current form state.
   *
   * The legend's held-stack label quotes how much of that line is clipped, so
   * it needs the y domain, which needs the simulated series — the legend
   * cannot be computed without doing the chart's arithmetic. Doing it in one
   * place is what keeps the tiles, the legend and the chart describing the
   * same simulation. `wealthExtent` is imported rather than re-inlined; the
   * copy that used to live here was a second definition of the y domain, the
   * exact drift the spec split exists to prevent.
   */
  function compute() {
    const opts = readOptions();
    if (!opts) return null;
    try {
      const { dca, lumpSum, delta } = compareDcaVsLumpSum(series, opts);
      const dcaPoints = dca.series.map((p) => ({ date: new Date(p.date), wealth: p.wealth }));
      const lumpPoints = lumpSum.series.map((p) => ({ date: new Date(p.date), wealth: p.wealth }));
      const wealthDomain = wealthExtent(dcaPoints, lumpPoints);

      // The reader's own stack, if they entered one on /holdings, valued at a
      // constant BTC amount across the same window. It answers the question the
      // simulator raises — how did what I actually did compare — without
      // pretending to know when any of it was bought.
      const stored = readHoldings();
      const held = stored && stored.btc > 0 ? stored.btc : null;
      const heldPoints =
        held === null
          ? []
          : holdingsSeries(series, held, dca.series[0]?.date)
              .map((p) => ({ date: new Date(p.date), wealth: p.value }))
              .filter((p) => Number.isFinite(p.wealth));
      return { dca, lumpSum, delta, dcaPoints, lumpPoints, wealthDomain, held, heldPoints };
    } catch {
      return 'no-purchases' as const;
    }
  }

  function renderLegend(state: Exclude<ReturnType<typeof compute>, null | 'no-purchases'>): void {
    if (!legend) return;
    const { held, heldPoints, wealthDomain } = state;
    // Both bounds, and the two cases said differently. Testing only the top
    // meant a stack small enough to sit entirely *below* the simulated lines'
    // floor drew no line at all while the legend and the tooltip went on
    // reporting it — a figure attached to a series that was nowhere on screen.
    const outside = (w: number): boolean => w > wealthDomain[1] || w < wealthDomain[0];
    const outsideCount = heldPoints.filter((p) => outside(p.wealth)).length;
    const heldNote = clipNote(outsideCount, heldPoints.length);
    const btcAmount = (v: number): string =>
      new Intl.NumberFormat('en-US', { maximumFractionDigits: 8 }).format(v);
    const heldLabel = held === null ? '' : `your ${btcAmount(held)} BTC${heldNote}`;
    const entries = [
      ...DCA_LEGEND_BASE,
      ...(held === null
        ? []
        : [{ label: heldLabel, color: 'var(--pos)', dash: 'dotted' as const }]),
    ];
    replaceIfChanged(
      legend,
      entries.map((entry) => {
        const item = document.createElement('span');
        item.className = 'legend-item';
        const swatch = document.createElement('span');
        swatch.className = 'legend-swatch';
        swatch.style.background = legendSwatch(entry);
        item.append(swatch, entry.label);
        return item;
      }),
    );
  }

  /**
   * The figures beside the chart. No Plot, so this runs on load and on every
   * keystroke without fetching anything.
   *
   * Split out because routing all of `render` through the chart upgrade left
   * the page arriving with an empty stat grid and an empty legend until
   * something touched the chart — a regression against the old behaviour,
   * where `responsiveChart` filled them on load. Worse, the grid is
   * `aria-live="polite"`, so a stray hover then announced all four at once.
   */
  function renderStats(): void {
    if (!stats) return;
    const state = compute();
    if (state === null) return;
    if (state === 'no-purchases') {
      stats.replaceChildren(tile('No purchases', '—', 'pick an earlier start date'));
      legend?.replaceChildren();
      return;
    }
    const { dca, lumpSum, delta } = state;
    // Same builder the build used, so the figures cannot differ between the
    // served markup and the first client render.
    replaceIfChanged(
      stats,
      dcaTiles(
        {
          totalInvested: dca.totalInvested,
          totalFees: dca.totalFees,
          buys: dca.purchases.length,
          btcAccumulated: dca.btcAccumulated,
          dcaFinal: dca.finalValue,
          dcaReturnPct: dca.returnPct,
          lumpFinal: lumpSum.finalValue,
          lumpReturnPct: lumpSum.returnPct,
          delta,
        },
        (v) => money.format(v),
        signedPct,
      ).map((t) => tile(t.label, t.value, t.sub, t.tone)),
    );
    renderLegend(state);
  }

  async function render(): Promise<void> {
    if (!container) return;

    // Fetched before the form is read, not after. Reading the inputs first and
    // awaiting afterwards threw away any edit that landed during the fetch:
    // with the chunk delayed, typing 1000 and then 9999 left the form showing
    // 9999 and the figures beside it computed from 1000, with nothing to
    // recover it. An 83 KB chunk is easily long enough to type into.
    const [{ drawChart }, { dcaSpec }] = await Promise.all([
      import('../lib/plot-client'),
      import('../lib/specs/dca'),
    ]);

    const state = compute();
    if (state === null) return;
    if (state === 'no-purchases') {
      // Empty the variants, not the container. Removing the wrappers would
      // strip the only record of which width each side is laid out at, and
      // every later render would fall back to the container's pixel width —
      // unscaled margins and type, the exact shape change this design exists
      // to avoid.
      const wrappers = container.querySelectorAll('.chart-at-narrow, .chart-at-wide');
      if (wrappers.length) wrappers.forEach((w) => w.replaceChildren());
      else container.replaceChildren();
      return;
    }
    const { dcaPoints, lumpPoints, heldPoints, wealthDomain } = state;

    drawChart(container, (w) =>
      dcaSpec({
        dcaPoints,
        lumpPoints,
        heldPoints,
        wealthDomain,
        width: w,
        axisMoney: (value: number) => money.format(value),
        tipMoney,
        interactive: true,
      }),
    );
  }

  // The tiles and legend are drawn immediately and on every keystroke; only
  // the chart waits for Plot.
  renderStats();

  if (container) {
    const upgrade = upgradeChart(container, render);
    const onChange = (): void => {
      renderStats();
      // The figures are already updated; a chart upgrade that is still in
      // flight rejects, and losing that race changes nothing on screen.
      void upgrade().catch(() => {});
    };
    form?.addEventListener('input', onChange);
    window.addEventListener(HOLDINGS_EVENT, onChange);
    // A reader who has entered holdings gets a third line the build could not
    // draw, so for them — and only them — the chart is rebuilt on arrival.
    const stored = readHoldings();
    if (stored && stored.btc > 0) void upgrade().catch(() => {});
  }
</script>
