---
import { stablecoins } from '../lib/data';
import { toJsonScript } from '../lib/embed';
import { renderChartSvg } from '../lib/plot-ssr';
import { SSR_WIDTH } from '../lib/plot-theme';
import { stablecoinSpec } from '../lib/specs/flows';

const svg = renderChartSvg(
  stablecoinSpec(
    stablecoins.series.map((p) => ({ date: new Date(p.date), totalUsd: p.totalUsd })),
    SSR_WIDTH,
  ),
);
---

<figure class="chart-frame">
  <script
    is:inline
    type="application/json"
    id="stablecoin-chart-data"
    set:html={toJsonScript(stablecoins.series)}
  />
  <div
    id="stablecoin-chart"
    role="img"
    aria-label="Area chart of total USD-pegged stablecoin circulating value over time"
    set:html={svg}
  />
</figure>

<script>
  import { chartData, upgradeChart } from '../lib/charts';

  const container = document.getElementById('stablecoin-chart');

  if (container) {
    upgradeChart(container, async () => {
      const [
        { drawChart },
        { stablecoinSpec, billions },
        { crosshairAnchors, isoDay },
      ] = await Promise.all([
        import('../lib/plot-client'),
        import('../lib/specs/flows'),
        import('../lib/crosshair'),
      ]);

      const series = chartData<{ date: string; totalUsd: number }[]>('stablecoin-chart-data');
      const points = series.map((p) => ({ date: new Date(p.date), totalUsd: p.totalUsd }));
      const anchors = crosshairAnchors(
        points.map((d) => ({ x: d.date, y: d.totalUsd, label: billions(d.totalUsd) })),
        isoDay,
      );

      const width = container.clientWidth || 720;
      drawChart(container, stablecoinSpec(points, width, anchors));
    });
  }
</script>
