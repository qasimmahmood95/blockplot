---
import { network } from '../lib/data';

const { tiers } = network.fees;
const rows = [
  { key: 'fastestFee', label: 'Next block', value: tiers.fastestFee },
  { key: 'halfHourFee', label: '~30 min', value: tiers.halfHourFee },
  { key: 'hourFee', label: '~1 hour', value: tiers.hourFee },
  { key: 'economyFee', label: 'Economy', value: tiers.economyFee },
  { key: 'minimumFee', label: 'Minimum', value: tiers.minimumFee },
];
---

<div class="fee-tiers" id="fee-tiers" aria-live="polite">
  {
    rows.map(({ key, label, value }) => (
      <div class="fee-tier">
        <span class="fee-label">{label}</span>
        <span class="fee-value num" data-fee={key}>
          {value}
        </span>
        <span class="fee-unit num">sat/vB</span>
      </div>
    ))
  }
</div>
<p class="fee-status num" id="fee-status">committed snapshot · {network.fetchedAt.slice(0, 16).replace('T', ' ')} UTC</p>

<script>
  // Fee tiers move on a ~10-minute timescale, so the committed snapshot is a
  // floor: refresh it live (the site's second sanctioned runtime fetch, see
  // CLAUDE.md) and keep the committed values on any failure.
  const KEYS = ['fastestFee', 'halfHourFee', 'hourFee', 'economyFee', 'minimumFee'] as const;
  const status = document.getElementById('fee-status');

  async function refreshFees(): Promise<void> {
    if (document.hidden) return;
    try {
      const res = await fetch('https://mempool.space/api/v1/fees/recommended', {
        headers: { accept: 'application/json' },
      });
      if (!res.ok) return;
      const payload = (await res.json()) as Partial<Record<(typeof KEYS)[number], number>>;
      if (KEYS.some((k) => typeof payload[k] !== 'number' || !(payload[k]! > 0))) return;
      for (const key of KEYS) {
        const el = document.querySelector(`[data-fee="${key}"]`);
        if (el) el.textContent = String(payload[key]);
      }
      if (status) {
        status.textContent = 'live · mempool.space';
        status.classList.add('fee-live');
      }
    } catch {
      // keep the committed snapshot
    }
  }

  refreshFees();
  setInterval(refreshFees, 120_000);
  document.addEventListener('visibilitychange', () => {
    if (!document.hidden) void refreshFees();
  });
</script>
