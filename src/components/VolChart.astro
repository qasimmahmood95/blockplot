---
import type { Currency } from '../lib/currency';
import { dataFor } from '../lib/data';
import { toJsonScript } from '../lib/embed';
import { renderResponsiveChart } from '../lib/plot-ssr';
import { volColor, volSpec } from '../lib/specs/vol';

interface Props {
  currency: Currency;
}

const { currency } = Astro.props;
const { riskMetrics } = dataFor(currency);
const payload = riskMetrics.rollingVol.filter((w) => w.series.length > 0);

const points = payload.flatMap((w) =>
  w.series.map((p) => ({ window: `${w.windowDays}d`, date: new Date(p.date), volPct: p.volPct })),
);
const lineEnds = payload.flatMap((w) => {
  const last = w.series[w.series.length - 1];
  return last ? [{ window: `${w.windowDays}d`, date: new Date(last.date), volPct: last.volPct }] : [];
});
const domain = payload.map((w) => `${w.windowDays}d`);
// The accessible name names the windows the chart actually draws. It listed
// "30, 90, and 365" as a literal, which would have gone false the moment the
// pipeline's window list changed while the lines beside it moved.
const days = payload.map((w) => String(w.windowDays));
const windowList =
  days.length > 1 ? `${days.slice(0, -1).join(', ')}, and ${days[days.length - 1]}` : (days[0] ?? '');

const svg = renderResponsiveChart((w) => volSpec(points, lineEnds, domain, w));
---

<figure class="chart-frame">
  <script is:inline type="application/json" id="vol-chart-data" set:html={toJsonScript(payload)} />
  <div id="vol-chart-legend" class="chart-legend" aria-hidden="true">
    {
      domain.map((w) => (
        <span class="legend-item">
          <span class="legend-swatch" style={`background:${volColor(w)}`} />
          {w}
        </span>
      ))
    }
  </div>
  <div
    id="vol-chart"
    role="img"
    aria-label={`Line chart of annualized BTC realized volatility over rolling ${windowList} day windows`}
    set:html={svg}
  />
</figure>

<script>
  import { chartData, upgradeChart } from '../lib/charts';

  const container = document.getElementById('vol-chart');

  if (container) {
    upgradeChart(container, async () => {
      const [{ drawChart }, { volSpec }, { crosshairAnchors, isoDay }] =
        await Promise.all([
          import('../lib/plot-client'),
          import('../lib/specs/vol'),
          import('../lib/crosshair'),
        ]);

      const windows = chartData<
        { windowDays: number; series: { date: string; volPct: number }[] }[]
      >('vol-chart-data');
      const points = windows.flatMap((w) =>
        w.series.map((p) => ({
          window: `${w.windowDays}d`,
          date: new Date(p.date),
          volPct: p.volPct,
        })),
      );
      const lineEnds = windows.flatMap((w) => {
        const last = w.series[w.series.length - 1];
        return last
          ? [{ window: `${w.windowDays}d`, date: new Date(last.date), volPct: last.volPct }]
          : [];
      });
      const domain = windows.map((w) => `${w.windowDays}d`);
      const anchors = crosshairAnchors(
        points.map((d) => ({
          x: d.date,
          y: d.volPct,
          label: `${d.window} ${d.volPct.toFixed(1)}%`,
        })),
        isoDay,
      );

      drawChart(container, (w) => volSpec(points, lineEnds, domain, w, anchors));
    });
  }
</script>
