---
import type { Currency } from '../lib/currency';
import { dataFor } from '../lib/data';
import { toJsonScript } from '../lib/embed';

interface Props {
  currency: Currency;
}

const { currency } = Astro.props;
const { riskMetrics } = dataFor(currency);
const payload = riskMetrics.rollingVol.filter((w) => w.series.length > 0);
---

<figure class="chart-frame">
  <script is:inline type="application/json" id="vol-chart-data" set:html={toJsonScript(payload)} />
  <div id="vol-chart-legend" class="chart-legend" aria-hidden="true"></div>
  <div
    id="vol-chart"
    role="img"
    aria-label="Line chart of annualized BTC realized volatility over rolling 30, 90, and 365 day windows"
  >
  </div>
</figure>

<script>
  import * as Plot from '@observablehq/plot';
  import { chartData, crosshairMarks, cssVar, responsiveChart } from '../lib/charts';
  import { isoDay } from '../lib/crosshair';

  const windows = chartData<{ windowDays: number; series: { date: string; volPct: number }[] }[]>(
    'vol-chart-data',
  );
  const container = document.getElementById('vol-chart');
  const legend = document.getElementById('vol-chart-legend');

  // Ordinal ramp: shorter window -> lighter accent step (shares the validated
  // cycle ramp); only populated windows render.
  const RAMP: Record<string, string> = { '30d': '--cycle-2', '90d': '--cycle-3', '365d': '--cycle-4' };
  const points = windows.flatMap((w) =>
    w.series.map((p) => ({ window: `${w.windowDays}d`, date: new Date(p.date), volPct: p.volPct })),
  );
  const lineEnds = windows.flatMap((w) => {
    const last = w.series[w.series.length - 1];
    return last
      ? [{ window: `${w.windowDays}d`, date: new Date(last.date), volPct: last.volPct }]
      : [];
  });
  const domain = windows.map((w) => `${w.windowDays}d`);

  function render(): void {
    if (!container) return;
    const range = domain.map((w) => cssVar(RAMP[w] ?? '--ink'));
    if (legend) {
      legend.replaceChildren(
        ...domain.map((w, i) => {
          const item = document.createElement('span');
          item.className = 'legend-item';
          const swatch = document.createElement('span');
          swatch.className = 'legend-swatch';
          swatch.style.background = range[i] ?? '';
          item.append(swatch, w);
          return item;
        }),
      );
    }
    container.replaceChildren(
      Plot.plot({
        width: container.clientWidth || 720,
        height: 300,
        marginLeft: 48,
        marginRight: 44,
        x: { label: null },
        y: { label: null, grid: true, tickFormat: (value: number) => `${value}%` },
        color: { domain, range },
        marks: [
          Plot.lineY(points, { x: 'date', y: 'volPct', stroke: 'window', strokeWidth: 1.75 }),
          Plot.text(lineEnds, {
            x: 'date',
            y: 'volPct',
            text: 'window',
            dx: 20,
            fill: cssVar('--ink'),
            fontSize: 11,
          }),
          // All three windows at the hovered date. Comparing them is the whole
          // reason they share an axis, and the per-point tip could only ever
          // report whichever line the cursor was nearest.
          ...crosshairMarks(
            points.map((d) => ({
              x: d.date,
              y: d.volPct,
              label: `${d.window} ${d.volPct.toFixed(1)}%`,
            })),
            isoDay,
          ),
        ],
        style: {
          background: 'transparent',
          color: cssVar('--ink-muted'),
          fontFamily: cssVar('--font-mono'),
          fontSize: '11px',
        },
      }),
    );
  }

  responsiveChart(render);
</script>
