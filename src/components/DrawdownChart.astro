---
import type { Currency } from '../lib/currency';
import { dataFor } from '../lib/data';
import { toJsonScript } from '../lib/embed';
import { renderChartSvg } from '../lib/plot-ssr';
import { SSR_WIDTH } from '../lib/plot-theme';
import { drawdownSpec } from '../lib/specs/drawdown';

interface Props {
  currency: Currency;
}

const { currency } = Astro.props;
const { riskMetrics } = dataFor(currency);

const svg = renderChartSvg(
  drawdownSpec(
    riskMetrics.drawdown.series.map((p) => ({ date: new Date(p.date), drawdownPct: p.drawdownPct })),
    SSR_WIDTH,
  ),
);
---

<figure class="chart-frame">
  <script
    is:inline
    type="application/json"
    id="drawdown-chart-data"
    set:html={toJsonScript(riskMetrics.drawdown.series)}
  />
  <div
    id="drawdown-chart"
    role="img"
    aria-label="Area chart of BTC decline from its running peak, per day"
    set:html={svg}
  />
</figure>

<script>
  import { chartData, upgradeChart } from '../lib/charts';

  const container = document.getElementById('drawdown-chart');

  if (container) {
    upgradeChart(container, async () => {
      const [{ drawChart }, { drawdownSpec }, { crosshairAnchors, isoDay }] =
        await Promise.all([
          import('../lib/plot-client'),
          import('../lib/specs/drawdown'),
          import('../lib/crosshair'),
        ]);

      const series = chartData<{ date: string; drawdownPct: number }[]>('drawdown-chart-data');
      const points = series.map((p) => ({ date: new Date(p.date), drawdownPct: p.drawdownPct }));
      const anchors = crosshairAnchors(
        points.map((d) => ({ x: d.date, y: d.drawdownPct, label: `${d.drawdownPct.toFixed(1)}%` })),
        isoDay,
      );

      const width = container.clientWidth || 720;
      drawChart(container, drawdownSpec(points, width, anchors));
    });
  }
</script>
