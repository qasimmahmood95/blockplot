---
import type { Currency } from '../lib/currency';
import { dataFor } from '../lib/data';
import { toJsonScript } from '../lib/embed';

interface Props {
  currency: Currency;
}

const { currency } = Astro.props;
const { riskMetrics } = dataFor(currency);
---

<figure class="chart-frame">
  <script
    is:inline
    type="application/json"
    id="drawdown-chart-data"
    set:html={toJsonScript(riskMetrics.drawdown.series)}
  />
  <div
    id="drawdown-chart"
    role="img"
    aria-label="Area chart of BTC decline from its running peak, per day"
  >
  </div>
</figure>

<script>
  import * as Plot from '@observablehq/plot';
  import { chartData, cssVar, responsiveChart } from '../lib/charts';
  import { crosshairAnchors, isoDay } from '../lib/crosshair';
  import { crosshairMarksFrom } from '../lib/crosshair-marks';

  const series = chartData<{ date: string; drawdownPct: number }[]>('drawdown-chart-data');
  const container = document.getElementById('drawdown-chart');
  const points = series.map((p) => ({ date: new Date(p.date), drawdownPct: p.drawdownPct }));

  const crosshair = crosshairAnchors(
    points.map((d) => ({ x: d.date, y: d.drawdownPct, label: `${d.drawdownPct.toFixed(1)}%` })),
    isoDay,
  );

  function render(): void {
    if (!container) return;
    const neg = cssVar('--neg');
    const width = container.clientWidth || 720;
    container.replaceChildren(
      Plot.plot({
        width,
        height: 260,
        marginLeft: 48,
        x: { label: null },
        y: { label: null, grid: true, tickFormat: (value: number) => `${value}%` },
        marks: [
          Plot.areaY(points, { x: 'date', y: 'drawdownPct', fill: neg, fillOpacity: 0.12 }),
          Plot.lineY(points, { x: 'date', y: 'drawdownPct', stroke: neg, strokeWidth: 1.5 }),
          Plot.ruleY([0], { stroke: cssVar('--line') }),
          ...crosshairMarksFrom(crosshair, width),
        ],
        style: {
          background: 'transparent',
          color: cssVar('--ink-muted'),
          fontFamily: cssVar('--font-mono'),
          fontSize: '11px',
        },
      }),
    );
  }

  responsiveChart(render);
</script>
