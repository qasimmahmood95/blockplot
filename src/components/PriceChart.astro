---
import { CURRENCY_META, type Currency } from '../lib/currency';
import { dataFor } from '../lib/data';
import { toJsonScript } from '../lib/embed';
import { encodeDaily } from '../lib/series-codec';
import { renderResponsiveChart } from '../lib/plot-ssr';
import { priceSpec } from '../lib/specs/price';

interface Props {
  currency: Currency;
}

const { currency } = Astro.props;
const { btcDaily } = dataFor(currency);
const code = CURRENCY_META[currency].code;
const payload = { code, series: encodeDaily(btcDaily.series, 'price') };

// Drawn here, once, at the width the viewBox scales from. The reader gets a
// finished chart in the HTML; Plot is fetched only if they hover it.
const svg = renderResponsiveChart((w) =>
  priceSpec(
    btcDaily.series.map((d) => ({ date: new Date(d.date), price: d.price })),
    code,
    w,
  ),
);
---

<figure class="chart-frame">
  <script is:inline type="application/json" id="price-chart-data" set:html={toJsonScript(payload)} />
  <div
    id="price-chart"
    role="img"
    aria-label="Line chart of the BTC daily closing price"
    set:html={svg}
  />
</figure>

<script>
  import { chartData, upgradeChart } from '../lib/charts';

  const container = document.getElementById('price-chart');

  if (container) {
    upgradeChart(container, async () => {
      // Plot, d3 and the chart's own spec arrive together, on demand. Nothing
      // above this line pulls them into the page's initial bundle.
      const [
        { drawChart },
        { priceSpec, priceFormat },
        { crosshairAnchors, isoDay },
      ] = await Promise.all([
        import('../lib/plot-client'),
        import('../lib/specs/price'),
        import('../lib/crosshair'),
      ]);

      const { decodeDaily } = await import('../lib/series-codec');
      const { code, series } = chartData<{
        code: string;
        series: Parameters<typeof decodeDaily>[0];
      }>('price-chart-data');
      const points = decodeDaily(series, 'price').map((d) => ({
        date: new Date(d.date as string),
        price: d.price as number,
      }));
      const money = priceFormat(code);
      const anchors = crosshairAnchors(
        points.map((d) => ({ x: d.date, y: d.price, label: money.format(d.price) })),
        isoDay,
      );

      drawChart(container, (w) => priceSpec(points, code, w, anchors));
    });
  }
</script>
