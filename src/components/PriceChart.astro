---
import { CURRENCY_META, type Currency } from '../lib/currency';
import { dataFor } from '../lib/data';
import { toJsonScript } from '../lib/embed';

interface Props {
  currency: Currency;
}

const { currency } = Astro.props;
const { btcDaily } = dataFor(currency);
const payload = { code: CURRENCY_META[currency].code, series: btcDaily.series };
---

<figure class="chart-frame">
  <script is:inline type="application/json" id="price-chart-data" set:html={toJsonScript(payload)} />
  <div id="price-chart" role="img" aria-label="Line chart of the BTC daily closing price"></div>
</figure>

<script>
  import * as Plot from '@observablehq/plot';
  import { chartData, cssVar, responsiveChart } from '../lib/charts';

  const { code, series } = chartData<{ code: string; series: { date: string; price: number }[] }>(
    'price-chart-data',
  );
  const container = document.getElementById('price-chart');
  const points = series.map((d) => ({ date: new Date(d.date), price: d.price }));
  const money = new Intl.NumberFormat('en-US', {
    style: 'currency',
    currency: code,
    maximumFractionDigits: 0,
  });

  function render(): void {
    if (!container) return;
    container.replaceChildren(
      Plot.plot({
        width: container.clientWidth || 720,
        height: 340,
        marginLeft: 70,
        x: { label: null },
        y: { label: null, grid: true, tickFormat: (value: number) => money.format(value) },
        marks: [
          Plot.lineY(points, {
            x: 'date',
            y: 'price',
            stroke: cssVar('--accent'),
            strokeWidth: 1.5,
          }),
        ],
        style: {
          background: 'transparent',
          color: cssVar('--ink-muted'),
          fontFamily: cssVar('--font-mono'),
          fontSize: '11px',
        },
      }),
    );
  }

  responsiveChart(render);
</script>
