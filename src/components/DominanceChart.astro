---
import { dominance } from '../lib/data';
import { toJsonScript } from '../lib/embed';
---

<figure class="chart-frame">
  <script is:inline type="application/json" id="dominance-chart-data" set:html={toJsonScript(dominance.series)} />
  <div
    id="dominance-chart"
    role="img"
    aria-label="Line chart of BTC dominance, accreting one point per day since the series began"
  >
  </div>
</figure>

<script>
  import * as Plot from '@observablehq/plot';
  import { chartData, cssVar, responsiveChart } from '../lib/charts';
  import { crosshairAnchors, isoDay } from '../lib/crosshair';
  import { crosshairMarksFrom } from '../lib/crosshair-marks';

  const series = chartData<{ date: string; btcDominancePct: number }[]>('dominance-chart-data');
  const container = document.getElementById('dominance-chart');
  const points = series.map((p) => ({ date: new Date(p.date), pct: p.btcDominancePct }));

  const crosshair = crosshairAnchors(
    points.map((d) => ({ x: d.date, y: d.pct, label: `BTC dominance ${d.pct.toFixed(2)}%` })),
    isoDay,
  );

  function render(): void {
    if (!container) return;
    const accent = cssVar('--accent');
    const width = container.clientWidth || 720;
    container.replaceChildren(
      Plot.plot({
        width,
        height: 240,
        marginLeft: 48,
        x: { label: null },
        y: {
          label: null,
          grid: true,
          tickFormat: (value: number) => `${value}%`,
        },
        marks: [
          // Dots keep a young accreted series visible before the line forms.
          Plot.dot(points, { x: 'date', y: 'pct', fill: accent, r: 2 }),
          Plot.lineY(points, { x: 'date', y: 'pct', stroke: accent, strokeWidth: 1.5 }),
          ...crosshairMarksFrom(crosshair, width),
        ],
        style: {
          background: 'transparent',
          color: cssVar('--ink-muted'),
          fontFamily: cssVar('--font-mono'),
          fontSize: '11px',
        },
      }),
    );
  }

  responsiveChart(render);
</script>
