---
import { dominance } from '../lib/data';
import { toJsonScript } from '../lib/embed';
import { renderChartSvg } from '../lib/plot-ssr';
import { SSR_WIDTH } from '../lib/plot-theme';
import { dominanceSpec } from '../lib/specs/flows';

const svg = renderChartSvg(
  dominanceSpec(
    dominance.series.map((p) => ({ date: new Date(p.date), pct: p.btcDominancePct })),
    SSR_WIDTH,
  ),
);
---

<figure class="chart-frame">
  <script
    is:inline
    type="application/json"
    id="dominance-chart-data"
    set:html={toJsonScript(dominance.series)}
  />
  <div
    id="dominance-chart"
    role="img"
    aria-label="Line chart of BTC dominance, accreting one point per day since the series began"
    set:html={svg}
  />
</figure>

<script>
  import { chartData, upgradeChart } from '../lib/charts';

  const container = document.getElementById('dominance-chart');

  if (container) {
    upgradeChart(container, async () => {
      const [{ drawChart }, { dominanceSpec }, { crosshairAnchors, isoDay }] =
        await Promise.all([
          import('../lib/plot-client'),
          import('../lib/specs/flows'),
          import('../lib/crosshair'),
        ]);

      const series = chartData<{ date: string; btcDominancePct: number }[]>('dominance-chart-data');
      const points = series.map((p) => ({ date: new Date(p.date), pct: p.btcDominancePct }));
      const anchors = crosshairAnchors(
        points.map((d) => ({ x: d.date, y: d.pct, label: `${d.pct.toFixed(2)}%` })),
        isoDay,
      );

      const width = container.clientWidth || 720;
      drawChart(container, dominanceSpec(points, width, anchors));
    });
  }
</script>
