---
import type { Currency } from '../lib/currency';
import { dataFor } from '../lib/data';
import { toJsonScript } from '../lib/embed';
import { renderChartSvg } from '../lib/plot-ssr';
import { SSR_WIDTH } from '../lib/plot-theme';
import { cycleColor, cyclesSpec } from '../lib/specs/cycles';

interface Props {
  currency: Currency;
}

const { currency } = Astro.props;
const { halvingCycles } = dataFor(currency);
const payload = halvingCycles.cycles.map((c) => ({
  label: c.halvingDate.slice(0, 4),
  series: c.series,
}));

const points = payload.flatMap((c) =>
  c.series.map((p) => ({ cycle: c.label, day: p.day, multiple: p.multiple })),
);
const lineEnds = payload.flatMap((c) => {
  const last = c.series[c.series.length - 1];
  return last ? [{ cycle: c.label, day: last.day, multiple: last.multiple }] : [];
});
const domain = payload.map((c) => c.label);

// Log is the pressed default, so that is the state the build draws.
const svg = renderChartSvg(cyclesSpec(points, lineEnds, domain, 'log', SSR_WIDTH));
---

<figure class="chart-frame">
  <div class="chart-controls">
    <div id="cycles-legend" class="chart-legend" aria-hidden="true">
      {
        domain.map((label, i) => (
          <span class="legend-item">
            <span class="legend-swatch" style={`background:${cycleColor(i)}`} />
            {label}
          </span>
        ))
      }
    </div>
    <div class="chart-toggle" role="group" aria-label="Y-axis scale">
      <button type="button" data-scale="log" aria-pressed="true">log</button>
      <button type="button" data-scale="linear" aria-pressed="false">linear</button>
    </div>
  </div>
  <script
    is:inline
    type="application/json"
    id="cycles-chart-data"
    set:html={toJsonScript(payload)}
  />
  <div
    id="cycles-chart"
    role="img"
    aria-label="Overlay of BTC price as a multiple of each halving-day close, by days since halving, for the four halving cycles"
    set:html={svg}
  />
</figure>

<script>
  import { chartData, upgradeChart } from '../lib/charts';
  import type { CycleScale } from '../lib/specs/cycles';

  const container = document.getElementById('cycles-chart');
  const toggle = document.querySelectorAll<HTMLButtonElement>('.chart-toggle button');

  if (container) {
    let scale: CycleScale = 'log';

    const upgrade = upgradeChart(container, async () => {
      const [{ drawChart }, { cyclesSpec }, { crosshairAnchors }] =
        await Promise.all([
          import('../lib/plot-client'),
          import('../lib/specs/cycles'),
          import('../lib/crosshair'),
        ]);

      const cyclesData = chartData<{ label: string; series: { day: number; multiple: number }[] }[]>(
        'cycles-chart-data',
      );
      const points = cyclesData.flatMap((c) =>
        c.series.map((p) => ({ cycle: c.label, day: p.day, multiple: p.multiple })),
      );
      const lineEnds = cyclesData.flatMap((c) => {
        const last = c.series[c.series.length - 1];
        return last ? [{ cycle: c.label, day: last.day, multiple: last.multiple }] : [];
      });
      const domain = cyclesData.map((c) => c.label);
      const anchors = crosshairAnchors(
        points.map((d) => ({
          x: d.day,
          y: d.multiple,
          label: `${d.cycle} ×${d.multiple.toFixed(2)}`,
        })),
        // Just "day N": the x-axis is already labelled "days since halving", and
        // spelling it out again made this the widest line in the tooltip, which
        // on a 320px screen is what pushed the whole tip off the edge.
        (day: number) => `day ${day}`,
      );

      const width = container.clientWidth || 720;
      drawChart(container, cyclesSpec(points, lineEnds, domain, scale, width, anchors));
    });

    toggle.forEach((button) => {
      button.addEventListener('click', () => {
        scale = button.dataset.scale === 'linear' ? 'linear' : 'log';
        toggle.forEach((b) => b.setAttribute('aria-pressed', String(b === button)));
        // Pressing the toggle is what asks for a chart the build did not draw,
        // so this is where the scale switch pays for Plot.
        upgrade();
      });
    });
  }
</script>
