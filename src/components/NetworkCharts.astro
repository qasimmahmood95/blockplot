---
import { network } from '../lib/data';
import { toJsonScript } from '../lib/embed';
import { renderResponsiveChart } from '../lib/plot-ssr';
import { NETWORK_SERIES, networkSpec } from '../lib/specs/network';

const payload = { hashRate: network.hashRate.series, txCount: network.txCount.series };
const toPoints = (s: { date: string; value: number }[]) =>
  s.map((p) => ({ date: new Date(p.date), value: p.value }));

const hashRateSvg = renderResponsiveChart((w) =>
  networkSpec(toPoints(payload.hashRate), NETWORK_SERIES['hashrate-chart'].tick, w),
);
const txCountSvg = renderResponsiveChart((w) =>
  networkSpec(toPoints(payload.txCount), NETWORK_SERIES['txcount-chart'].tick, w),
);
---

<script is:inline type="application/json" id="network-chart-data" set:html={toJsonScript(payload)} />

<figure class="chart-frame">
  <figcaption class="chart-caption num">hash rate · EH/s</figcaption>
  <div
    id="hashrate-chart"
    role="img"
    aria-label="Line chart of Bitcoin network hash rate in exahashes per second"
    set:html={hashRateSvg}
  />
</figure>

<figure class="chart-frame chart-frame-stacked">
  <figcaption class="chart-caption num">transactions · per day</figcaption>
  <div
    id="txcount-chart"
    role="img"
    aria-label="Line chart of confirmed Bitcoin transactions per day"
    set:html={txCountSvg}
  />
</figure>

<script>
  import { chartData, upgradeChart } from '../lib/charts';

  type Point = { date: string; value: number };

  /**
   * Both charts' rows are fixed at build time, so the parse and the grouping
   * are cached per chart id rather than redone per draw — a resize drag runs
   * the render once per animation frame, and without this each frame
   * re-parsed the whole inline payload and rebuilt every anchor. Measured at
   * 14 full `JSON.parse` calls across one 15-step drag.
   */
  const cache = new Map<string, { points: { date: Date; value: number }[]; anchors: unknown }>();

  // Each chart upgrades on its own hover, so a reader who only ever touches the
  // hash rate never pays for the transaction chart's crosshair either.
  for (const id of ['hashrate-chart', 'txcount-chart'] as const) {
    const container = document.getElementById(id);
    if (!container) continue;

    upgradeChart(container, async () => {
      const [
        { drawChart },
        { networkSpec, NETWORK_SERIES },
        { crosshairAnchors, isoDay },
      ] = await Promise.all([
        import('../lib/plot-client'),
        import('../lib/specs/network'),
        import('../lib/crosshair'),
      ]);

      const { tick, tip } = NETWORK_SERIES[id];
      let entry = cache.get(id);
      if (!entry) {
        const data = chartData<{ hashRate: Point[]; txCount: Point[] }>('network-chart-data');
        const raw = id === 'hashrate-chart' ? data.hashRate : data.txCount;
        const points = raw.map((p) => ({ date: new Date(p.date), value: p.value }));
        entry = {
          points,
          anchors: crosshairAnchors(
            points.map((d) => ({ x: d.date, y: d.value, label: tip(d.value) })),
            isoDay,
          ),
        };
        cache.set(id, entry);
      }

      const points = entry.points;
      const anchors = entry.anchors as Parameters<typeof networkSpec>[3];
      drawChart(container, (w) => networkSpec(points, tick, w, anchors));
    });
  }
</script>
